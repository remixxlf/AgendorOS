{
  "name": "GestorOS",
  "version": "1.0.1",
  "description": "Sistema de Gestao de OS e Erp's",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64",
    "build:protected": "node scripts/build-protected.js"
  },
  "dependencies": {
    "bytenode": "^1.5.5",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "node-cron": "^3.0.3",
    "qrcode": "^1.5.4",
    "sqlite": "^5.1.1",
    "sqlite3": "^6.0.1",
    "untun": "^0.2.2",
    "whatsapp-web.js": "^1.34.7"
  },
  "devDependencies": {
    "electron": "^29.4.6",
    "electron-builder": "^24.13.3",
    "javascript-obfuscator": "^4.1.1"
  },
  "build": {
    "appId": "com.agendamentos.app",
    "productName": "GestorOS",
    "npmRebuild": false,
    "asar": true,
    "asarUnpack": [
      "node_modules/sqlite3/**",
      "node_modules/bytenode/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "runAfterFinish": true
    },
    "files": [
      "**/*",
      "!src/**",
      "!scripts/**",
      "!.build-tmp/**",
      "!node_modules/electron",
      "!node_modules/electron-builder",
      "!node_modules/javascript-obfuscator"
    ]
  }
}
